---
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config/site';

const currentYear = new Date().getFullYear();
const quickLinks = [
  { label: 'Home', href: '/#home' },
  { label: 'Services', href: '/#services' },
  { label: 'Industries', href: '/#industries' },
  { label: 'Case Studies', href: '/case-studies/' },
  { label: 'Insights', href: '/blog/' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' }
];

const serviceLinks = [
  'Process Automation',
  'AI Decision Support',
  'Data Integration',
  'Custom Workflows',
  'API Integration'
];
---
<footer class="border-t border-gray-100 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="mb-4 flex items-center gap-3">
          <img
            src="/images/logo.png"
            alt={siteConfig.title}
            class="h-8 w-8"
            loading="lazy"
          />
          <p class="text-xl font-medium text-gray-900">{siteConfig.title}</p>
        </div>
        <p class="mb-6 max-w-xl text-gray-500">
          Intelligent automation with measurable results. Process automation, AI decision support, and data integration for manufacturing, healthcare, and publishing operations.
        </p>
        <div class="flex gap-4">
          {siteConfig.social.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-600 hover:text-gray-900 transition-colors duration-200"
              aria-label={link.label}
            >
              <Icon name={link.icon} class="h-6 w-6" />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="mb-4 text-lg font-medium text-gray-900">Quick Links</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a class="text-gray-500 transition hover:text-gray-900" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-lg font-medium text-gray-900">Services</h4>
        <ul class="space-y-3">
          {serviceLinks.map((item) => (
            <li class="text-gray-500">{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-gray-200 pt-6 text-sm text-gray-400 sm:flex sm:items-center sm:justify-between">
      <p>© {currentYear} {siteConfig.title}. All rights reserved.</p>
      <a
        class="mt-4 inline-flex items-center gap-2 text-gray-400 transition hover:text-gray-600 sm:mt-0"
        href={`mailto:${siteConfig.email}`}
      >
        {siteConfig.email}
        <Icon name="lucide:external-link" class="h-4 w-4" />
      </a>
    </div>
  </div>
</footer>
