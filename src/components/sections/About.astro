---
import { Icon } from 'astro-icon/components';
import AboutCard from '../react/AboutCard';

const stats = [
  {
    icon: 'lucide:users',
    number: '6-7x',
    label: 'Capacity Increase',
    context: 'Clinical trial patient matching',
    link: '/case-studies/clinical-trial-patient-matching'
  },
  {
    icon: 'lucide:clock',
    number: '87.5%',
    label: 'Time Reduction',
    context: 'Production scheduling optimization',
    link: '/case-studies/manufacturing-production-scheduling'
  },
  {
    icon: 'lucide:trending-up',
    number: '16 hrs',
    label: 'Saved Per Week',
    context: 'Ad performance reporting',
    link: '/case-studies/ad-performance-reporting'
  },
  {
    icon: 'lucide:arrow-up-right',
    number: '200K → 2M',
    label: 'MAU Growth',
    context: 'Content strategy and analytics',
    link: '/case-studies/content-strategy-growth'
  }
];
---
<section id="about" class="bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Eyebrow -->
    <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-gray-900">
      About
    </p>

    <!-- Headline -->
    <h2 class="mb-8 text-4xl font-light text-gray-900">
      Why Companies Choose Us
    </h2>

    <!-- 2-Column Layout: About Cards + Founder Photo -->
    <div class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">

      <!-- Column 1: About Cards -->
      <div class="flex flex-col gap-6">
        <AboutCard
          title="Tailored Solutions"
          description="Every project is unique. We build custom solutions that fit your specific needs and scale with your growth."
          client:idle
        />
        <AboutCard
          title="Proven Results"
          description="Our clients see measurable improvements in efficiency, cost reduction, and revenue growth."
          client:idle
        />
        <AboutCard
          title="Expert Team"
          description="Our team stays at the forefront of AI and automation technologies to deliver cutting-edge solutions. Our globally distributed team means faster turnaround for your projects."
          client:idle
        />
      </div>

      <!-- Column 2: Founder Photo Placeholder -->

    </div>

    <!-- Stats Cards (Full Width Below) -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <a href={stat.link} class="block rounded-xl border border-gray-100 bg-white p-6 text-center shadow-md hover:shadow-lg transition-shadow duration-300 cursor-pointer">
          <div class="mb-3 flex justify-center">
            <Icon name={stat.icon} class="h-8 w-8 text-gray-900" />
          </div>
          <p class="mb-2 text-3xl font-light text-gray-900">{stat.number}</p>
          <p class="mb-1 text-sm font-semibold uppercase tracking-wide text-gray-900">{stat.label}</p>
          <p class="text-sm text-gray-500">{stat.context}</p>
        </a>
      ))}
    </div>

  </div>
</section>
