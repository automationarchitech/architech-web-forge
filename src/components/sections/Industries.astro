---
// Industries We Serve section
import IndustryCard from '../react/IndustryCard';

const industries = [
  {
    icon: 'lucide:scale',
    title: 'Legal Tech',
    items: [
      'Legal document processing',
      'Contract analysis automation',
      'Compliance workflows'
    ],
    ctaLink: '/case-studies/?industry=legal-tech'
  },
  {
    icon: 'lucide:heart',
    title: 'Healthcare',
    items: [
      'Clinical trial patient matching',
      'Eligibility verification',
      'Medical record processing',
      'EHR integration'
    ],
    ctaLink: '/case-studies/?industry=healthcare'
  },
  {
    icon: 'lucide:newspaper',
    title: 'Publishing & Media',
    items: [
      'Campaign coordination and link management',
      'Multi-platform ad performance reporting',
      'Content distribution automation',
      'Audience analytics consolidation'
    ],
    ctaLink: '/case-studies/?industry=publishing-media'
  },
  {
    icon: 'lucide:shopping-cart',
    title: 'E-commerce',
    items: [
      'Inventory synchronization across channels',
      'Order routing and fulfillment automation',
      'Customer data consolidation',
      'Multi-platform performance tracking'
    ],
    ctaLink: '/case-studies/?industry=e-commerce'
  },
  {
    icon: 'lucide:graduation-cap',
    title: 'Education Technology',
    items: [
      'Student data integration',
      'Learning management system automation',
      'Assessment workflow optimization',
      'Educational content distribution'
    ],
    ctaLink: '/case-studies/?industry=education-technology'
  },
  {
    icon: 'lucide:factory',
    title: 'Manufacturing',
    items: [
      'Production scheduling and capacity planning',
      'Changeover optimization',
      'Shop floor coordination',
      'Quality data aggregation and maintenance tracking'
    ],
    ctaLink: '/case-studies/?industry=manufacturing'
  }
];
---

<section id="industries" class="py-20 bg-gray-50">
  <div class="container mx-auto px-4">
    {/* Section Header */}
    <div class="text-center mb-16">
      <h2 class="text-4xl font-light text-gray-900 mb-4">
        Industries We Serve
      </h2>
      <p class="text-xl text-gray-600 font-normal max-w-4xl mx-auto">
        We understand industry-specific challenges—from production scheduling bottlenecks to multi-platform ad reporting. See how we've helped companies in your industry.
      </p>
    </div>

    {/* Industries Grid */}
    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {industries.map((industry) => (
        <IndustryCard
          icon={industry.icon}
          title={industry.title}
          items={industry.items}
          ctaLink={industry.ctaLink}
          client:idle
        />
      ))}
    </div>
  </div>
</section>
