---
import { Icon } from 'astro-icon/components';

const stats = [
  { icon: 'lucide:briefcase', number: '50+', label: 'Projects Delivered' },
  { icon: 'lucide:calendar', number: '8 Years', label: 'Industry Experience' },
  { icon: 'lucide:clock', number: '87.5%', label: 'Average Time Reduction' },
  { icon: 'lucide:check-circle', number: '99%', label: 'AI Accuracy' }
];
---
<!-- Stats Section -->
<section class="border-b border-t border-gray-100 bg-white py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Stats Grid - 4 cards in horizontal row (15% smaller) -->
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">

      {stats.map((stat) => (
        <a href="/case-studies/" class="block rounded-lg border border-gray-100 bg-gray-50 p-4 text-center shadow-sm transition-all duration-300 hover:shadow-md">
          <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-white">
            <Icon name={stat.icon} class="h-5 w-5 text-gray-900" />
          </div>
          <div class="mb-1 text-2xl font-light text-gray-900 md:text-3xl">{stat.number}</div>
          <div class="text-xs font-medium text-gray-600 md:text-sm">{stat.label}</div>
        </a>
      ))}

    </div>
  </div>
</section>
