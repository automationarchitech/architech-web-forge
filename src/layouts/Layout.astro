---
import Navigation from '@/components/react/Navigation';
import Footer from '@/components/Footer.astro';
import SeoHead, { type JsonLdInput } from '@/components/SeoHead.astro';
import { siteConfig } from '@/config/site';
import { Toaster } from 'sonner';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hero?: string;
  seoType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  jsonLd?: JsonLdInput;
  hideFooter?: boolean;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  hero,
  seoType = 'website',
  publishedAt,
  updatedAt,
  jsonLd,
  hideFooter = false,
  noindex = false
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <SeoHead
    title={title}
    description={description}
    hero={hero}
    seoType={seoType}
    publishedAt={publishedAt}
    updatedAt={updatedAt}
    jsonLd={jsonLd}
    noindex={noindex}
  />
  <body class="bg-background text-foreground">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:text-gray-900"
      href="#main"
    >
      Skip to content
    </a>
    <Navigation client:load />
    <main id="main" class="pt-20 md:pt-24">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <Toaster position="top-center" richColors client:load />
    <script is:inline>
      // Ad attribution and conversion tracking. Keeps the latest UTM/click ids
      // so the contact form can submit them, and sends GA4 events for clicks on
      // the booking links and email address.
      (function () {
        var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'gbraid', 'wbraid'];
        try {
          var params = new URLSearchParams(window.location.search);
          var found = {};
          keys.forEach(function (k) { if (params.get(k)) found[k] = params.get(k); });
          if (Object.keys(found).length) {
            found.landing_page = window.location.pathname;
            found.captured_at = new Date().toISOString();
            localStorage.setItem('aa_attribution', JSON.stringify(found));
          }
        } catch (e) {}

        document.addEventListener('click', function (event) {
          var link = event.target.closest && event.target.closest('a[href]');
          if (!link || typeof window.gtag !== 'function') return;
          var href = link.getAttribute('href') || '';
          if (href.indexOf('calendar.app.google') !== -1) {
            window.gtag('event', 'book_call_click', { link_text: link.textContent.trim(), link_url: href });
          } else if (href.indexOf('mailto:') === 0) {
            window.gtag('event', 'email_click', { link_url: href });
          }
        });
      })();
    </script>
  </body>
</html>
